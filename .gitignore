# Node.js & Dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Lambda deployment zips
*.zip

# Environment & local OS files
.env
.env.*
.DS_Store

# Local .terraform directories
**/.terraform/

# .tfstate files (state files contain infrastructure details & sensitive data)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Exclude all .tfvars files as they contain sensitive data (AWS access keys, secrets)
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI local configuration records
.terraformrc
terraform.rc
